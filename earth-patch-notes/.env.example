# ── Claude (대본 작성) ─────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5

# ── Higgsfield (영상 생성) — https://cloud.higgsfield.ai 에서 발급 ──
HF_API_KEY=your-api-key-id
HF_API_SECRET=your-api-secret
# 모드: image-to-video (Soul 9:16 이미지 → Kling 영상, 세로 쇼츠에 추천)
#       text-to-video  (프롬프트만으로 영상 생성, 가로 영상이면 가운데를 잘라 세로로 만듦)
# HF_MODE=image-to-video
# HF_IMAGE_MODEL=higgsfield-ai/soul/standard
# HF_VIDEO_MODEL=kling-video/v2.5-turbo/pro/image-to-video
# HF_T2V_MODEL=kling-video/v2.5-turbo/pro/text-to-video
# 모델이 허용하는 길이(초). Kling=5,10 / Hailuo=6,10
# HF_VIDEO_DURATIONS=5,10

# ── 음성 (edge-tts, 무료) ─────────────────────────
# TTS_VOICE=ko-KR-InJoonNeural
# TTS_RATE=+12%

# ── YouTube 업로드 ───────────────────────────────
# YT_CLIENT_SECRETS=client_secret.json
# YT_TOKEN_FILE=youtube_token.json
# 처음엔 private 로 올려서 확인 후 공개하는 걸 추천
# YT_PRIVACY=private
# YT_CATEGORY_ID=28

# ── 기타 ─────────────────────────────────────────
# FONT_PATH=/path/to/NotoSansKR-Bold.ttf
# CHANNEL_NAME=지구 패치노트
